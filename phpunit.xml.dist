<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="var/cache/.phpunit.cache"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true"
         stopOnFailure="false"
         stopOnError="false"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="1"/>
        <ini name="display_startup_errors" value="1"/>
    </php>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <logging>
        <junit outputFile="var/tests/report.xml"/>
    </logging>
    <coverage includeUncoveredFiles="true"
              pathCoverage="false"
              ignoreDeprecatedCodeUnits="true"
              disableCodeCoverageIgnore="true">
        <report>
            <text outputFile="php://stdout"
                  showUncoveredFiles="true"/>
        </report>
    </coverage>
    <extensions>
        <bootstrap class="RobinIngelbrecht\PHPUnitCoverageTools\PhpUnitExtension">
            <parameter name="exitOnLowCoverage" value="1"/>
            <parameter name="cleanUpCloverXml" value="0"/>
        </bootstrap>
    </extensions>
</phpunit>
